+++ b/src/preview.rs
@@ -0,0 +1,370 @@
+use std::{
+    collections::HashMap,
+    sync::{
+        mpsc::{self, Receiver},
+        Arc, Condvar, Mutex,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+use crate::{herdr::CommandExecutor, model::PaneTarget};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum PreviewStatus {
+    Unavailable,
+    Loading,
+    Ready(String),
+}
+
+struct Request {
+    generation: u64,
+    target: PaneTarget,
+}
+
+struct ResultMessage {
+    generation: u64,
+    target: PaneTarget,
+    result: Result<String, String>,
+}
+
+pub(crate) struct PreviewController {
+    requests: Arc<(Mutex<PendingRequest>, Condvar)>,
+    results: Receiver<ResultMessage>,
+    cache: HashMap<PaneTarget, CachedPreview>,
+    current: Option<PaneTarget>,
+    generation: u64,
+    status: PreviewStatus,
+    ttl: Duration,
+}
+
+#[derive(Default)]
+struct PendingRequest {
+    request: Option<Request>,
+    closed: bool,
+}
+
+struct CachedPreview {
+    value: String,
+    loaded_at: Instant,
+}
+
+const PREVIEW_TTL: Duration = Duration::from_secs(2);
+const PREVIEW_TIMEOUT: Duration = Duration::from_millis(750);
+const MAX_CACHE_ENTRIES: usize = 64;
+
+impl PreviewController {
+    pub(crate) fn new(executor: Arc<dyn CommandExecutor>) -> Self {
+        Self::with_ttl(executor, PREVIEW_TTL)
+    }
+
+    fn with_ttl(executor: Arc<dyn CommandExecutor>, ttl: Duration) -> Self {
+        let requests = Arc::new((Mutex::new(PendingRequest::default()), Condvar::new()));
+        let worker_requests = requests.clone();
+        let (result_tx, result_rx) = mpsc::channel::<ResultMessage>();
+        thread::spawn(move || loop {
+            let request = {
+                let (pending, ready) = &*worker_requests;
+                let mut pending = pending.lock().unwrap();
+                while pending.request.is_none() && !pending.closed {
+                    pending = ready.wait(pending).unwrap();
+                }
+                if pending.closed {
+                    return;
+                }
+                pending.request.take().unwrap()
+            };
+            let result = executor
+                .text_timeout(
+                    &[
+                        "pane",
+                        "read",
+                        &request.target.id,
+                        "--source",
+                        "recent-unwrapped",
+                        "--lines",
+                        "80",
+                    ],
+                    PREVIEW_TIMEOUT,
+                )
+                .map(normalize_output);
+            if result_tx
+                .send(ResultMessage {
+                    generation: request.generation,
+                    target: request.target,
+                    result,
+                })
+                .is_err()
+            {
+                return;
+            }
+        });
+        Self {
+            requests,
+            results: result_rx,
+            cache: HashMap::new(),
+            current: None,
+            generation: 0,
+            status: PreviewStatus::Unavailable,
+            ttl,
+        }
+    }
+
+    pub(crate) fn select(&mut self, target: Option<PaneTarget>) {
+        if self.current == target {
+            match (&target, &self.status) {
+                (Some(target), PreviewStatus::Ready(_))
+                    if self
+                        .cache
+                        .get(target)
+                        .is_some_and(|cached| cached.loaded_at.elapsed() >= self.ttl) => {}
+                _ => return,
+            }
+        }
+        self.generation = self.generation.wrapping_add(1);
+        self.current = target.clone();
+        let Some(target) = target else {
+            self.status = PreviewStatus::Unavailable;
+            return;
+        };
+        if let Some(cached) = self
+            .cache
+            .get(&target)
+            .filter(|cached| cached.loaded_at.elapsed() < self.ttl)
+        {
+            self.status = PreviewStatus::Ready(cached.value.clone());
+            return;
+        }
+        self.status = PreviewStatus::Loading;
+        let (pending, ready) = &*self.requests;
+        pending.lock().unwrap().request = Some(Request {
+            generation: self.generation,
+            target,
+        });
+        ready.notify_one();
+    }
+
+    pub(crate) fn poll(&mut self) {
+        while let Ok(message) = self.results.try_recv() {
+            if message.generation != self.generation
+                || self.current.as_ref() != Some(&message.target)
+            {
+                continue;
+            }
+            self.status = match message.result {
+                Ok(value) => {
+                    if self.cache.len() >= MAX_CACHE_ENTRIES {
+                        if let Some(stale) = self
+                            .cache
+                            .keys()
+                            .find(|target| Some(*target) != self.current.as_ref())
+                            .cloned()
+                        {
+                            self.cache.remove(&stale);
+                        }
+                    }
+                    self.cache.insert(
+                        message.target,
+                        CachedPreview {
+                            value: value.clone(),
+                            loaded_at: Instant::now(),
+                        },
+                    );
+                    PreviewStatus::Ready(value)
+                }
+                Err(_) => PreviewStatus::Unavailable,
+            };
+        }
+    }
+
+    pub(crate) fn status(&self) -> &PreviewStatus {
+        &self.status
+    }
+
+    pub(crate) fn invalidate(&mut self) {
+        self.generation = self.generation.wrapping_add(1);
+        self.current = None;
+        self.cache.clear();
+        self.status = PreviewStatus::Unavailable;
+    }
+}
+
+impl Drop for PreviewController {
+    fn drop(&mut self) {
+        let (pending, ready) = &*self.requests;
+        pending.lock().unwrap().closed = true;
+        ready.notify_one();
+    }
+}
+
+fn normalize_output(value: String) -> String {
+    let Ok(json) = serde_json::from_str::<serde_json::Value>(&value) else {
+        return value;
+    };
+    [
+        "/result/content",
+        "/result/text",
+        "/result/output",
+        "/content",
+        "/text",
+        "/output",
+    ]
+    .into_iter()
+    .find_map(|path| json.pointer(path).and_then(serde_json::Value::as_str))
+    .unwrap_or(&value)
+    .to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{
+        sync::{Arc, Condvar, Mutex},
+        time::Duration,
+    };
+
+    use serde_json::Value;
+
+    use super::*;
+
+    struct BlockingExecutor {
+        calls: Mutex<Vec<String>>,
+        ready: Condvar,
+    }
+
+    impl CommandExecutor for BlockingExecutor {
+        fn json(&self, _: &[&str]) -> Result<Value, String> {
+            Ok(Value::Null)
+        }
+
+        fn quiet(&self, _: &[&str]) -> Result<(), String> {
+            Ok(())
+        }
+
+        fn text(&self, args: &[&str]) -> Result<String, String> {
+            let mut calls = self.calls.lock().unwrap();
+            calls.push(args[2].into());
+            self.ready.notify_all();
+            if args[2] == "old" {
+                std::thread::sleep(Duration::from_millis(30));
+            }
+            Ok(format!("preview {}", args[2]))
+        }
+    }
+
+    fn target(id: &str, revision: &str) -> PaneTarget {
+        PaneTarget {
+            id: id.into(),
+            revision: Some(revision.into()),
+        }
+    }
+
+    #[test]
+    fn cache_keys_include_revision_and_stale_results_are_rejected() {
+        let executor = Arc::new(BlockingExecutor {
+            calls: Mutex::new(Vec::new()),
+            ready: Condvar::new(),
+        });
+        let mut previews = PreviewController::new(executor.clone());
+        previews.select(Some(target("old", "1")));
+        let calls = executor.calls.lock().unwrap();
+        let _ = executor
+            .ready
+            .wait_timeout_while(calls, Duration::from_secs(1), |calls| calls.is_empty())
+            .unwrap();
+        previews.select(Some(target("middle", "1")));
+        previews.select(Some(target("new", "1")));
+        std::thread::sleep(Duration::from_millis(60));
+        previews.poll();
+        assert_eq!(
+            previews.status(),
+            &PreviewStatus::Ready("preview new".into())
+        );
+
+        previews.select(Some(target("new", "2")));
+        assert_eq!(previews.status(), &PreviewStatus::Loading);
+        std::thread::sleep(Duration::from_millis(20));
+        previews.poll();
+        assert_eq!(
+            previews.status(),
+            &PreviewStatus::Ready("preview new".into())
+        );
+        assert_eq!(executor.calls.lock().unwrap().len(), 3);
+        assert!(!executor.calls.lock().unwrap().contains(&"middle".into()));
+    }
+
+    #[test]
+    fn cached_preview_refreshes_after_ttl() {
+        let executor = Arc::new(BlockingExecutor {
+            calls: Mutex::new(Vec::new()),
+            ready: Condvar::new(),
+        });
+        let mut previews = PreviewController::with_ttl(executor.clone(), Duration::from_millis(5));
+        let selected = target("current", "1");
+        previews.select(Some(selected.clone()));
+        std::thread::sleep(Duration::from_millis(10));
+        previews.poll();
+        assert!(matches!(previews.status(), PreviewStatus::Ready(_)));
+
+        std::thread::sleep(Duration::from_millis(6));
+        previews.select(Some(selected));
+        assert_eq!(previews.status(), &PreviewStatus::Loading);
+        std::thread::sleep(Duration::from_millis(10));
+        previews.poll();
+        assert_eq!(executor.calls.lock().unwrap().len(), 2);
+    }
+
+    #[test]
+    fn preview_output_accepts_plain_text_and_json_envelopes() {
+        assert_eq!(normalize_output("plain".into()), "plain");
+        assert_eq!(
+            normalize_output(r#"{"result":{"content":"terminal output"}}"#.into()),
+            "terminal output"
+        );
+    }
+
+    #[test]
+    fn preview_worker_generates_exact_pane_read_command() {
+        struct RecordingExecutor(Mutex<Vec<Vec<String>>>);
+
+        impl CommandExecutor for RecordingExecutor {
+            fn json(&self, _: &[&str]) -> Result<Value, String> {
+                Ok(Value::Null)
+            }
+
+            fn quiet(&self, _: &[&str]) -> Result<(), String> {
+                Ok(())
+            }
+
+            fn text(&self, args: &[&str]) -> Result<String, String> {
+                self.0
+                    .lock()
+                    .unwrap()
+                    .push(args.iter().map(|arg| (*arg).into()).collect());
+                Ok("output".into())
+            }
+        }
+
+        let executor = Arc::new(RecordingExecutor(Mutex::new(Vec::new())));
+        let mut previews = PreviewController::new(executor.clone());
+        previews.select(Some(target("w2:p3", "9")));
+        for _ in 0..20 {
+            if !executor.0.lock().unwrap().is_empty() {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        previews.poll();
+        assert_eq!(
+            *executor.0.lock().unwrap(),
+            vec![vec![
+                "pane",
+                "read",
+                "w2:p3",
+                "--source",
+                "recent-unwrapped",
+                "--lines",
+                "80",
+            ]]
+        );
+    }
+}
