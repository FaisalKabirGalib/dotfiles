# Ghostty Terminal Configuration
# Migrated from Alacritty setup with Catppuccin Mocha theme

# Font Configuration
font-family = CaskaydiaMono Nerd Font
font-size = 16

# Window Configuration
window-padding-x = 14
window-padding-y = 14
window-decoration = false
background-opacity = 0.80

# Shell Configuration
command = zsh -l

# Terminal Environment
term = xterm-256color

# Keybindings
keybind = f11=toggle_fullscreen

# Basic Performance Optimizations
confirm-close-surface = false
mouse-hide-while-typing = true

# Clipboard Integration
copy-on-select = false

# Scrollback
scrollback-limit = 10000

# Window Controls
quit-after-last-window-closed = true

# Shell Integration
shell-integration = detect

# Colors: Omarchy's dynamic theme system isn't available on macOS, so use
# Ghostty's own bundled Catppuccin Mocha theme (matches the original palette).
theme = catppuccin-mocha

# Cursor (style only — color is derived from the theme)
cursor-style = block
cursor-style-blink = false

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
