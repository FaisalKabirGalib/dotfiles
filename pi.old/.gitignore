# Machine-specific and sensitive files — never commit these
.pi/agent/auth.json
.pi/agent/sessions/

# Node modules from extension dependencies
.pi/agent/extensions/**/node_modules/
.pi/agent/extensions/**/package-lock.json

# Pi package installs (installed via `pi install`)
.pi/agent/git/
.pi/agent/npm/

# Temp / cache
.pi/agent/*.log
