{
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(basename $PWD); if command -v osascript >/dev/null 2>&1; then osascript -e \"display notification \\\"Task completed\\\" with title \\\"Claude Code - $DIR\\\"\"; elif command -v notify-send >/dev/null 2>&1; then notify-send \"Claude Code - $DIR\" \"Task completed\"; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "glm-plan-usage@zai-coding-plugins": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "zai-coding-plugins": {
      "source": {
        "source": "github",
        "repo": "zai-org/zai-coding-plugins"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim"
}
