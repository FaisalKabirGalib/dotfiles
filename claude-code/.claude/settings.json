{
  "permissions": {
    "allow": [
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(brew search *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/plan-to-vault.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(basename $PWD); if command -v osascript >/dev/null 2>&1; then osascript -e \"display notification \\\"Task completed\\\" with title \\\"Claude Code - $DIR\\\"\"; elif command -v notify-send >/dev/null 2>&1; then notify-send \"Claude Code - $DIR\" \"Task completed\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "pipecat-cloud@pipecat-skills": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "pipecat-skills": {
      "source": {
        "source": "github",
        "repo": "pipecat-ai/skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
