#!/usr/bin/env bash
# Stow dotfile packages. With no args, stows every package containing a
# PACKAGE.md marker. With args, stows only the named packages.
#
#   ./stowup            # stow all packages
#   ./stowup nvim zsh   # stow only nvim and zsh

set -euo pipefail

stow_pkg() {
	local pkg="${1%/}"
	if [ ! -f "$pkg/PACKAGE.md" ]; then
		echo "skipping $pkg (no PACKAGE.md)" >&2
		return
	fi
	echo "stowing $pkg"
	stow -D "$pkg" 2>/dev/null || true
	stow "$pkg"
}

echo "stowing dotfiles....."

if [ "$#" -gt 0 ]; then
	for pkg in "$@"; do stow_pkg "$pkg"; done
else
	for pkg in */; do stow_pkg "$pkg"; done
fi
