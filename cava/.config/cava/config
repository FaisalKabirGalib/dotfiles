# cava — console audio visualizer
# Themed to match the Ethereal identity: indigo (bottom) -> peach (top).

[general]
framerate = 60
# 0 = auto-fit the number of bars to the terminal width
bars = 0
bar_width = 2
bar_spacing = 1
autosens = 1
overshoot = 20

[input]
# PipeWire exposes a PulseAudio server, so the pulse backend works out of the box.
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '#7d82d9'
gradient_color_2 = '#9a8fd3'
gradient_color_3 = '#bf9cbf'
gradient_color_4 = '#e0b1a6'
gradient_color_5 = '#ffcead'
gradient_color_6 = '#ffe2c8'

[smoothing]
noise_reduction = 0.77
