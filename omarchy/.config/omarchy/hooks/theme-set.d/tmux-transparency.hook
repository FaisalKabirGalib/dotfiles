#!/bin/bash

# Restore tmux pane transparency after a theme change.
#
# omarchy-theme-set-tmux sets `window-style`/`window-active-style` to an
# explicit `bg=` taken from the theme's colors.toml. That makes tmux paint
# every pane cell with an opaque background, which defeats the terminal's
# `background-opacity` (Ghostty here) — panes go solid while unwrapped
# terminal windows stay transparent.
#
# omarchy-theme-set runs the tmux sync before the theme-set hooks, so resetting
# both options here wins. `default` means "use the terminal's own background",
# which is what makes transparency work.

tmux list-sessions >/dev/null 2>&1 || exit 0

tmux set-option -g window-style default 2>/dev/null || true
tmux set-option -g window-active-style default 2>/dev/null || true

while IFS= read -r client; do
  [[ -n $client ]] || continue
  tmux refresh-client -t "$client" 2>/dev/null || true
done < <(tmux list-clients -F "#{client_name}" 2>/dev/null)
