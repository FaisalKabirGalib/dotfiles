# =============================================================================
# SSH Configuration File
# =============================================================================

# === SSH Agent Configuration ===
# Add keys to agent automatically
AddKeysToAgent yes

# Identity file locations (try these in order)
#
IdentityFile ~/.ssh/id_rsa
IdentityFile ~/.ssh/id_ed25519

# Connection settings
# Send keepalive packets to detect connection drops
ServerAliveInterval 60
ServerAliveCountMax 3

# Compression (comment out if causing issues)
Compression yes

# === Common Server Patterns ===

# GitHub
Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes

# GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentitiesOnly yes

# === Personal Servers ===

# Amazon Lightsail - Forum
Host forum
    HostName 35.178.236.39
    User ubuntu
    IdentityFile ~/.ssh/forum-key.pem
    IdentitiesOnly yes

# VPS - faisal.click
Host vps
    HostName ssh.faisal.click
    User galib
    IdentityFile ~/.ssh/id_rsa
    IdentitiesOnly yes

# AgriPulse Server
Host agripulse
    HostName 20.244.105.40
    User dev
    IdentityFile ~/.ssh/server_key
    IdentitiesOnly yes

# === Kubernetes VPS ===

# Kubernetes VPS - AWS
Host kube_vps
    HostName 13.126.197.249
    User faisal
    IdentityFile ~/.ssh/kube_rsa
    IdentitiesOnly yes

# Local VPS - Softcell
Host local_vps
    HostName vm.softcellbd.net
    Port 65535
    User root
    IdentityFile ~/.ssh/kube_rsa
    IdentitiesOnly yes

# === Generic Development Settings ===
# Apply these settings to all hosts
Host *
    # Use faster cipher suites
    Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com,aes128-gcm@openssh.com
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256

    # Escape character (default: ~)
    EscapeChar ~

    # X11 forwarding (uncomment if needed)
    # ForwardX11 yes

    # Agent forwarding (use with caution)
    # ForwardAgent yes
