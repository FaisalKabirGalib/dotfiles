{
  "agent-notifications": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agent-notify antigravity input-required \"$PWD\" \"Permission requested\"",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "ask_permission"
      }
    ],
    "Stop": [
      {
        "command": "agent-notify antigravity completed \"$PWD\"",
        "timeout": 3,
        "type": "command"
      }
    ]
  },
  "herdr": {
    "PreInvocation": [
      {
        "command": "bash '/home/galib/.gemini/config/hooks/herdr-agent-state.sh' session",
        "timeout": 10,
        "type": "command"
      }
    ]
  }
}