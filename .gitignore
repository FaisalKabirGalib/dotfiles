# SSH keys - NEVER commit these
*.pem
*.key
id_rsa
id_ed25519

# Ignore entire .ssh directory by default
ssh/.ssh/id_*
ssh/.ssh/*.pem
ssh/.ssh/*.key
ssh/.ssh/known_hosts
ssh/.ssh/known_hosts.old
ssh/.ssh/authorized_keys

# But DO track SSH config
!ssh/.ssh/config

# Machine-specific files
*.local
# ...but *.local also matches the XDG ~/.local dir; keep the bin package trackable
!bin/.local/
!bin/.local/**
.env
credentials*

# Backup files
*.bak
*~
*.swp

# Tmux log files
tmux-client-*.log
tmux-server-*.log

# Node modules anywhere (extension deps are installed locally, never committed)
node_modules/

# Pi (oh-my-pi, ~/.omp) runtime / session files
pi/.omp/agent/sessions/
pi/.omp/agent/terminal-sessions/
pi/.omp/agent/blobs/
pi/.omp/agent/*.db*
pi/.omp/agent/auth.json
pi/.omp/agent/last-changelog-version

# pi.old (~/.pi) runtime / session files
pi.old/.pi/agent/sessions/
pi.old/.pi/agent/terminal-sessions/
pi.old/.pi/agent/blobs/
pi.old/.pi/agent/*.db*
pi.old/.pi/agent/auth.json
pi.old/.pi/agent/last-changelog-version

# Antigravity CLI machine-local state (trustedFolders accumulates local project
# paths; regenerated by the CLI, not ours to track)
agy/.gemini/antigravity-cli/settings.json
