# SSH keys - NEVER commit these
*.pem
*.key
id_rsa
id_ed25519

# Ignore everything in .ssh by default (keys of any name, known_hosts, etc.)
ssh/.ssh/*

# But DO track SSH config
!ssh/.ssh/config

# And keep the agent socket dir present, but never its runtime socket file
!ssh/.ssh/agent/
ssh/.ssh/agent/*
!ssh/.ssh/agent/.gitkeep

# Machine-specific files
*.local
# ...but *.local also matches the XDG ~/.local dir; keep the bin package trackable
!bin/.local/
!bin/.local/**
.env
credentials*

# Backup files
*.bak
*~
*.swp

# Tmux log files
tmux-client-*.log
tmux-server-*.log

# Node modules anywhere (extension deps are installed locally, never committed)
node_modules/

# Pi (oh-my-pi, ~/.omp) runtime / session files
pi/.omp/agent/sessions/
pi/.omp/agent/terminal-sessions/
pi/.omp/agent/*.db*
pi/.omp/agent/auth.json

# pi.old (~/.pi) runtime / session files
pi.old/.pi/agent/sessions/
pi.old/.pi/agent/terminal-sessions/
pi.old/.pi/agent/*.db*
pi.old/.pi/agent/auth.json
