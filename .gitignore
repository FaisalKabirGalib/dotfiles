# SSH keys - NEVER commit these
*.pem
*.key
id_rsa
id_ed25519

# Ignore entire .ssh directory by default
ssh/.ssh/id_*
ssh/.ssh/*.pem
ssh/.ssh/*.key
ssh/.ssh/known_hosts
ssh/.ssh/known_hosts.old
ssh/.ssh/authorized_keys

# But DO track SSH config
!ssh/.ssh/config

# Machine-specific files
*.local
# ...but *.local also matches the XDG ~/.local dir; keep the bin package trackable
!bin/.local/
!bin/.local/**
.env
credentials*

# Backup files
*.bak
*~
*.swp

# Tmux log files
tmux-client-*.log
tmux-server-*.log

# Node modules anywhere (extension deps are installed locally, never committed)
node_modules/

# omp (oh-my-pi, ~/.omp) runtime / session files
omp/.omp/agent/sessions/
omp/.omp/agent/terminal-sessions/
omp/.omp/agent/blobs/
omp/.omp/agent/*.db*
omp/.omp/agent/auth.json
omp/.omp/agent/last-changelog-version

# omp.old (~/.omp predecessor) runtime / session files
omp.old/.omp/agent/sessions/
omp.old/.omp/agent/terminal-sessions/
omp.old/.omp/agent/blobs/
omp.old/.omp/agent/*.db*
omp.old/.omp/agent/auth.json
omp.old/.omp/agent/last-changelog-version

# Antigravity CLI machine-local state (trustedFolders accumulates local project
# paths; regenerated by the CLI, not ours to track)
agy/.gemini/antigravity-cli/settings.json

# Understand Anything temporary analysis artifacts
.ua/.trash-*/
.ua/tmp/
