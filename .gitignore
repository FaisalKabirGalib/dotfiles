# SSH keys - NEVER commit these
*.pem
*.key
id_rsa
id_ed25519

# Ignore everything in .ssh by default (keys of any name, known_hosts, etc.)
ssh/.ssh/*

# But DO track SSH config
!ssh/.ssh/config

# And keep the agent socket dir present, but never its runtime socket file
!ssh/.ssh/agent/
ssh/.ssh/agent/*
!ssh/.ssh/agent/.gitkeep

# Machine-specific files
*.local
# ...but *.local also matches the XDG ~/.local dir; keep the bin package trackable
!bin/.local/
!bin/.local/**
.env
credentials*

# Backup files
*.bak
*~
*.swp

# Tmux log files
tmux-client-*.log
tmux-server-*.log

# Node modules anywhere (extension deps are installed locally, never committed)
node_modules/

# VS Code (~/Library/Application Support/Code) -- this whole directory is
# symlinked into place, so Electron/Chromium cache, session, and per-window
# state land inside the repo. Only the actual user config is worth tracking.
vscode/Library/Application Support/Code/*
!vscode/Library/Application Support/Code/User
vscode/Library/Application Support/Code/User/*
!vscode/Library/Application Support/Code/User/settings.json
!vscode/Library/Application Support/Code/User/keybindings.json
!vscode/Library/Application Support/Code/User/snippets

# OMP (oh-my-pi, ~/.omp) runtime / session files
omp/.omp/agent/sessions/
omp/.omp/agent/terminal-sessions/
omp/.omp/agent/*.db*
omp/.omp/agent/auth.json
omp/.omp/agent/blobs/
omp/.omp/gpu_cache.json
omp/.omp/logs/
omp/.omp/natives/

# Pi (pi-coding-agent, ~/.pi) runtime / session files
pi/.pi/agent/sessions/
pi/.pi/agent/terminal-sessions/
pi/.pi/agent/*.db*
pi/.pi/agent/auth.json
pi/.pi/agent/blobs/
pi/.pi/gpu_cache.json
pi/.pi/logs/
pi/.pi/natives/



# Agy (Antigravity CLI, ~/.gemini) runtime state -- ~/.gemini is symlinked
# whole (not tree-folded per-file) to agy/.gemini, so every cache/log/db the
# CLI writes anywhere under ~/.gemini/ lands directly inside the repo. Same
# problem as the VS Code block above, same fix: ignore everything under the
# app's state dir except the actual user config.
agy/.gemini/projects.json*.tmp
agy/.gemini/antigravity-cli/*
!agy/.gemini/antigravity-cli/settings.json
!agy/.gemini/antigravity-cli/plugins
