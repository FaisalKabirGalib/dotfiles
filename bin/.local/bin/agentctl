#!/usr/bin/env bash
set -euo pipefail

root=${AGENT_KIT_ROOT:-"$HOME/.config/agent-kit"}
force=false
if [[ ${1:-} == --force ]]; then
	force=true
	shift
fi
[[ " $* " == *" --force "* ]] && force=true

usage() {
	printf '%s\n' 'usage: agentctl {init <profile> [profile... ]|sync|status|skills install <name>|doctor} [--force]'
}

profiles_from_config() {
	awk '
    $0 == "profiles:" { in_profiles = 1; next }
    /^[^ ]/ { in_profiles = 0 }
    in_profiles && /^  - / { sub(/^  - /, ""); print }
  ' .agent-kit/config.yml
}

write_owned() {
	local path=$1
	if [[ -e $path && $force != true ]] && ! grep -q '^<!-- Generated by agentctl -->$' "$path"; then
		printf 'refusing to overwrite user-owned %s; use --force\n' "$path" >&2
		return 1
	fi
	mkdir -p "$(dirname "$path")"
	{
		printf '%s\n\n' '<!-- Generated by agentctl -->'
		cat "$root/catalog/policy/base.md"
		while IFS= read -r profile; do
			printf '\n'
			cat "$root/catalog/profiles/$profile/instructions.md"
		done < <(profiles_from_config)
		if [[ -f .agent-kit/instructions.md ]]; then
			printf '\n# Project Rules\n\n'
			cat .agent-kit/instructions.md
		fi
	} >"$path"
}

init() {
	local profile
	local -a profiles=()
	for profile in "$@"; do
		[[ $profile == --force ]] || profiles+=("$profile")
	done
	(( ${#profiles[@]} > 0 )) || {
		usage >&2
		exit 1
	}
	for profile in "${profiles[@]}"; do
		[[ -f $root/catalog/profiles/$profile/instructions.md ]] || {
			printf 'unknown profile: %s\n' "$profile" >&2
			exit 1
		}
	done
	mkdir -p .agent-kit
	if [[ ! -e .agent-kit/config.yml ]]; then
		{
			printf 'profiles:\n  - base\n'
			for profile in "${profiles[@]}"; do
				[[ $profile == base ]] || printf '  - %s\n' "$profile"
			done
			printf 'harnesses:\n  - claude\n  - codex\n  - opencode\n'
		} >.agent-kit/config.yml
	else
		for profile in "${profiles[@]}"; do
			grep -Fqx "  - $profile" .agent-kit/config.yml || sed -i "/^harnesses:/i\\  - $profile" .agent-kit/config.yml
		done
	fi
	if [[ ! -e .agent-kit/instructions.md ]]; then
		printf '%s\n' 'Add project-specific agent instructions here.' >.agent-kit/instructions.md
	fi
	sync
}

sync() {
	[[ -f .agent-kit/config.yml ]] || {
		printf '%s\n' 'run agentctl init <profile> first' >&2
		exit 1
	}
	while IFS= read -r profile; do
		[[ -f $root/catalog/profiles/$profile/instructions.md ]] || {
			printf 'missing profile: %s\n' "$profile" >&2
			exit 1
		}
	done < <(profiles_from_config)
	write_owned AGENTS.md
	write_owned CLAUDE.md
	write_owned GEMINI.md
	write_owned .opencode/AGENTS.md
}

status() {
	printf 'agent-kit: %s\n' "$root"
	if [[ -f .agent-kit/config.yml ]]; then
		printf 'profiles: '
		paste -sd, < <(profiles_from_config)
		printf '\n'
	else
		printf '%s\n' 'project: not initialized'
	fi
}

skills_install() {
	local name=${1:-}
	[[ -n $name ]] || {
		usage >&2
		exit 1
	}
	local record
	record=$(awk -v name="$name" '
    $0 == "  - name: " name { found = 1; next }
    found && /^    source:/ { source = $2 }
    found && /^    revision:/ { revision = $2 }
    found && /^    scope:/ { print source " " revision " " $2; exit }
  ' "$root/catalog/skills.yml")
	[[ -n $record ]] || {
		printf 'unknown skill: %s\n' "$name" >&2
		exit 1
	}
	read -r source revision _ <<<"$record"
	[[ $revision != UNRESOLVED ]] || {
		printf 'skill %s has no immutable revision; update catalog/skills.yml first\n' "$name" >&2
		exit 1
	}
	[[ $source != local:legacy ]] || {
		printf 'skill %s remains in its legacy harness location pending migration\n' "$name" >&2
		exit 1
	}
	[[ $source == github:* && $revision =~ ^[0-9a-f]{40}$ ]] || {
		printf 'unsupported pinned source for %s: %s\n' "$name" "$source" >&2
		exit 1
	}
	local repo=${source#github:}
	local data=${XDG_DATA_HOME:-"$HOME/.local/share"}/agent-kit/skills
	local store=$data/$name/$revision
	local target=${AGENT_KIT_SKILLS_DIR:-"$HOME/.agents/skills"}/$name
	local temporary
	temporary=$(mktemp -d)
	trap 'rm -rf "$temporary"' RETURN
	git clone --quiet "https://github.com/$repo.git" "$temporary/repo"
	git -C "$temporary/repo" checkout --quiet --detach "$revision"
	[[ $(git -C "$temporary/repo" rev-parse HEAD) == "$revision" ]] || {
		printf 'resolved revision does not match registry for %s\n' "$name" >&2
		exit 1
	}
	[[ -f $temporary/repo/SKILL.md ]] || {
		printf 'skill %s does not expose a root SKILL.md\n' "$name" >&2
		exit 1
	}
	mkdir -p "$store" "$(dirname "$target")"
	cp -R "$temporary/repo/." "$store/"
	if [[ -e $target || -L $target ]] && [[ $(readlink -f "$target") != "$data"/* ]]; then
		printf 'refusing to replace user-owned skill %s\n' "$target" >&2
		exit 1
	fi
	ln -sfn "$store" "$target"
	printf 'installed %s at %s\n' "$name" "$target"
}

doctor() {
	local failed=false
	[[ -d $root/catalog ]] || {
		printf 'missing catalog: %s\n' "$root"
		failed=true
	}
	command -v agent-notify >/dev/null 2>&1 || {
		printf '%s\n' 'agent-notify is not on PATH'
		failed=true
	}
	if grep -q 'revision: UNRESOLVED' "$root/catalog/skills.yml"; then
		printf '%s\n' 'unresolved skill pins: grills'
		failed=true
	fi
	cat "$root/catalog/capabilities.yml"
	$failed && return 1
}

case ${1:-} in
init) shift; init "$@" ;;
sync) sync ;;
status) status ;;
skills)
	[[ ${2:-} == install ]] || {
		usage >&2
		exit 1
	}
	skills_install "${3:-}"
	;;
doctor) doctor ;;
*)
	usage >&2
	exit 1
	;;
esac
