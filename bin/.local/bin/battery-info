#!/bin/bash
# battery-info — rich battery report: state, charge, power draw, time,
# charge cycles, and health. Designed for a waybar right-click notify-send,
# but also runs standalone in a terminal.

set -uo pipefail

# Pick the first battery present.
bat=""
for b in /sys/class/power_supply/BAT*; do
  [[ -d $b ]] && bat="$b" && break
done
if [[ -z $bat ]]; then
  echo "No battery found"
  exit 0
fi

read -r status <"$bat/status" 2>/dev/null || status="Unknown"
read -r capacity <"$bat/capacity" 2>/dev/null || capacity="?"
cycles=$(cat "$bat/cycle_count" 2>/dev/null)

# Health = current full charge vs factory design capacity.
full=$(cat "$bat/charge_full" 2>/dev/null || cat "$bat/energy_full" 2>/dev/null)
design=$(cat "$bat/charge_full_design" 2>/dev/null || cat "$bat/energy_full_design" 2>/dev/null)
health=""
if [[ -n ${full:-} && -n ${design:-} && $design -gt 0 ]]; then
  health=$((full * 100 / design))
fi

# Power draw + time-to via upower (clean units, signed handling).
info=$(upower -i "$(upower -e | grep -m1 BAT)" 2>/dev/null)
power=$(awk '/energy-rate/{printf "%.1f", $2; exit}' <<<"$info")
time_to=$(awk -F: '/time to/{sub(/^[^:]*:[[:space:]]*/,""); print; exit}' <<<"$info")

case "$status" in
  Charging) head="󰂄  Charging" ;;
  Discharging) head="󰁹  Discharging" ;;
  Full) head="󰂅  Full" ;;
  "Not charging") head="󰚥  Plugged in (not charging)" ;;
  *) head="󰁹  $status" ;;
esac

line="$head  ·  ${capacity}%"
[[ -n ${power:-} && $power != "0.0" ]] && line+="  ·  ${power}W"
if [[ $status == "Charging" && -n ${time_to:-} ]]; then
  line+="  ·  ${time_to} to full"
elif [[ $status == "Discharging" && -n ${time_to:-} ]]; then
  line+="  ·  ${time_to} left"
fi

line+=$'\n'"󰓅  ${cycles:-unknown} charge cycles"
[[ -n $health ]] && line+="  ·  ${health}% health"

printf '%s\n' "$line"
