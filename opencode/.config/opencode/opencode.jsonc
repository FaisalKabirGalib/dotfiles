{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "AGENTS.md"
  ],
  "model": "zai-coding-plan/glm-5.1",
  "small_model": "zai-coding-plan/glm-4.7-flash",
  "default_agent": "plan",
  "autoupdate": true,
  "share": "manual",
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec env Z_AI_MODE=ZAI Z_AI_API_KEY=\"$(pass ApiKey/ZAi/opencode | head -n 1)\" npx -y @z_ai/mcp-server"
      ],
      "enabled": true
    },
    "web-search-prime": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec npx -y mcp-remote https://api.z.ai/api/mcp/web_search_prime/mcp --transport http-only --header \"Authorization: Bearer $(pass ApiKey/ZAi/opencode | head -n 1)\""
      ],
      "enabled": true
    },
    "web-reader": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec npx -y mcp-remote https://api.z.ai/api/mcp/web_reader/mcp --transport http-only --header \"Authorization: Bearer $(pass ApiKey/ZAi/opencode | head -n 1)\""
      ],
      "enabled": true
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "agent-browser",
        "mcp"
      ],
      "enabled": true
    }
  }
}
