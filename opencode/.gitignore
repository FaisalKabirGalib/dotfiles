# Environment variables
.config/opencode/.env
.config/opencode/.env.local
.config/opencode/.env.*.local

# Plugin dependency manifests -- regenerated by opencode when it installs a
# plugin (e.g. the dynamic-context-pruning plugin); node_modules/ itself is
# covered by the root .gitignore's global rule.
.config/opencode/dcp.jsonc
.config/opencode/package.json
.config/opencode/package-lock.json
